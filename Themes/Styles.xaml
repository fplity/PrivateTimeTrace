<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="InkBrush" Color="#23364D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#657992" />
    <LinearGradientBrush x:Key="PillBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B0FFFFFF" Offset="0" /><GradientStop Color="#556AB4FF" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D071B6FF" Offset="0" /><GradientStop Color="#F03591FA" Offset=".4" /><GradientStop Color="#ED1773DC" Offset=".83" /><GradientStop Color="#B98BC8FF" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SelectedBrush" StartPoint="0,0" EndPoint=".3,1"><GradientStop Color="#DFFFFFFF" Offset="0" /><GradientStop Color="#606BB4FF" Offset=".7" /><GradientStop Color="#A0C8E4FF" Offset="1" /></LinearGradientBrush>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource InkBrush}" /></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Padding" Value="18,10" /><Setter Property="CornerRadius" Value="22" /><Setter Property="Background" Value="{StaticResource PillBrush}" />
        <Setter Property="BorderBrush" Value="#DFFFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Light.Opacity" Value="1" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Light.Opacity" Value=".15" /></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value=".45" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusRing.Opacity" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                <Border x:Name="Light" Margin="1" CornerRadius="{TemplateBinding CornerRadius}" Opacity=".45" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint=".6,1"><GradientStop Color="#80FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset=".38" /><GradientStop Color="#05FFFFFF" Offset=".8" /><GradientStop Color="#70FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
                <Border x:Name="FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="#2589EF" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassRadio" TargetType="RadioButton">
        <Setter Property="Padding" Value="15,9" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value=".3" /></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value=".4" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Unchecked" /><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Selection.Opacity" Value="1" /><Setter Target="Presenter.Foreground" Value="#126FCB" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusRing.Opacity" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Background="{TemplateBinding Background}" CornerRadius="20" />
                <Border x:Name="Hover" Background="#68FFFFFF" CornerRadius="20" Opacity="0" />
                <Border x:Name="Selection" Background="{StaticResource SelectedBrush}" CornerRadius="20" BorderBrush="#DEFFFFFF" BorderThickness="1" Opacity="0" />
                <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
                <Border x:Name="FocusRing" CornerRadius="20" BorderBrush="#2589EF" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavRadio" TargetType="RadioButton" BasedOn="{StaticResource GlassRadio}"><Setter Property="Padding" Value="17,15" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="FontSize" Value="15" /></Style>
    <Style x:Key="RecordItem" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="4,0" /></Style>
</ResourceDictionary>
