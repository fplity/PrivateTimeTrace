<Page x:Class="PrivateTimeTrace.MainPage" x:Name="RootPage" RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:PrivateTimeTrace.Controls" xmlns:data="using:PrivateTimeTrace.Data">
    <Grid x:Name="WindowRoot" Background="#E8F1FC">
        <Image x:Name="Wallpaper" Source="ms-appx:///Assets/LiquidBackdrop.png" Stretch="UniformToFill" IsHitTestVisible="False" Margin="-8" />
        <Border x:Name="FrostVeil" Background="#D1EBF4FF" Opacity="0" IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="DragRegion" Margin="24,0,150,0" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><FontIcon Glyph="&#xE823;" FontSize="17" Foreground="#3C5875" /><TextBlock Text="时间迹" Foreground="#334D68" FontSize="13" VerticalAlignment="Center" /></StackPanel></Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="198" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ui:GlassPanel x:Name="Sidebar" Margin="12,6,2,18" Padding="10,22,10,18" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ui:LiquidSelector Margin="0,40,0,0" VerticalAlignment="Top" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}"><StackPanel Spacing="12">
                            <RadioButton x:Name="OverviewNav" GroupName="Navigation" Style="{StaticResource NavRadio}" IsChecked="True" Tag="Overview" Click="Navigation_Click" AutomationProperties.AutomationId="NavOverview" AutomationProperties.Name="概览" ToolTipService.ToolTip="概览"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE80F;" FontSize="18" /><TextBlock x:Name="OverviewNavText" Text="概览" /></StackPanel></RadioButton>
                            <RadioButton x:Name="RecordsNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Records" Click="Navigation_Click" AutomationProperties.AutomationId="NavRecords" AutomationProperties.Name="学习记录" ToolTipService.ToolTip="学习记录"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE8A5;" FontSize="18" /><TextBlock x:Name="RecordsNavText" Text="学习记录" /></StackPanel></RadioButton>
                            <RadioButton x:Name="AnalyticsNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Analytics" Click="Navigation_Click" AutomationProperties.AutomationId="NavAnalytics" AutomationProperties.Name="数据分析" ToolTipService.ToolTip="数据分析"><StackPanel Orientation="Horizontal" Spacing="13"><FontIcon Glyph="&#xE9D2;" FontSize="18" /><TextBlock x:Name="AnalyticsNavText" Text="数据分析" /></StackPanel></RadioButton>
                        </StackPanel></ui:LiquidSelector>
                        <StackPanel Grid.Row="1" Margin="16,0" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="数据仅保存在本机"><FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="#6B839C" /><TextBlock x:Name="LocalSavedText" Text="本地保存" Style="{StaticResource MutedText}" /></StackPanel><TextBlock x:Name="ThemeCaption" Text="液态流光" Foreground="#8494A7" FontSize="11" Margin="20,0,0,0" /></StackPanel>
                    </Grid>
                </ui:GlassPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="HeaderGrid" Margin="32,16,32,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5"><TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Foreground="#1B304A" /><TextBlock Text="{x:Bind ViewModel.DateLabel, Mode=OneWay}" Style="{StaticResource MutedText}" /></StackPanel>
                            <ui:LiquidSelector Grid.Column="1" VerticalAlignment="Center" Background="#50FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1" Padding="3" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FrostedStyleButton" Content="霜白玻璃" GroupName="VisualStyle" Style="{StaticResource GlassRadio}" Tag="Frosted" Click="Style_Click" AutomationProperties.AutomationId="StyleFrosted" ToolTipService.ToolTip="霜白玻璃 · 柔和磨砂与安静留白" />
                                    <RadioButton x:Name="LiquidStyleButton" Content="液态流光" GroupName="VisualStyle" Style="{StaticResource GlassRadio}" Tag="Liquid" Click="Style_Click" AutomationProperties.AutomationId="StyleLiquid" ToolTipService.ToolTip="液态流光 · 通透边缘、空间光影与悬停高光" />
                                </StackPanel>
                            </ui:LiquidSelector>
                        </Grid>
                <ScrollViewer Grid.Row="1" x:Name="MainScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="MainScroll_SizeChanged">
                    <StackPanel x:Name="MainStack" Spacing="20" Margin="28,12,28,28">
                        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                        <ui:GlassPanel x:Name="FocusCard" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}" Padding="28,22" Visibility="{x:Bind ViewModel.IsOverviewVisible, Mode=OneWay}">
                            <Grid x:Name="FocusGrid">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="TimerStack" Spacing="10" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="5" Height="5" Fill="#398BDD" VerticalAlignment="Center" /><TextBlock Text="{x:Bind ViewModel.SessionStatus, Mode=OneWay}" Style="{StaticResource MutedText}" /></StackPanel>
                                    <TextBlock x:Name="TimerText" Text="{x:Bind ViewModel.ElapsedDisplay, Mode=OneWay}" FontFamily="Segoe UI Variable Display" FontSize="58" FontWeight="Light" CharacterSpacing="40" Foreground="#162E4D" AutomationProperties.AutomationId="ElapsedTime" />
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="NoteBox" Text="{x:Bind ViewModel.SessionNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="今天想学些什么？" IsEnabled="{x:Bind ViewModel.CanEditNote, Mode=OneWay}" MaxLength="120" CornerRadius="18" Background="#5CFFFFFF" BorderBrush="#6FB3CEE8" BorderThickness="1" Padding="12,7" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="学习主题" AutomationProperties.AutomationId="SessionNote" />
                                        <Button Grid.Column="1" x:Name="TimerButton" Content="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.StartOrStopCommand}" Style="{StaticResource GlassButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="SemiBold" Padding="20,9" MinWidth="115" AutomationProperties.AutomationId="TimerAction" />
                                    </Grid>
                                </StackPanel>
                                <Grid Grid.Column="1" x:Name="SummaryGrid" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border BorderBrush="#306184A6" BorderThickness="1,0,0,0" Padding="23,10"><StackPanel Spacing="13"><TextBlock Text="今日累计" Style="{StaticResource MutedText}" /><TextBlock x:Name="TodayTotal" Text="{x:Bind ViewModel.TodayTotalDisplay, Mode=OneWay}" FontSize="25" FontWeight="Light" Foreground="#203B59" TextWrapping="Wrap" /></StackPanel></Border>
                                    <Border Grid.Column="1" BorderBrush="#306184A6" BorderThickness="1,0,0,0" Padding="23,10"><StackPanel Spacing="13"><TextBlock Text="本周累计" Style="{StaticResource MutedText}" /><TextBlock Text="{x:Bind ViewModel.WeekTotalDisplay, Mode=OneWay}" FontSize="25" FontWeight="Light" Foreground="#203B59" TextWrapping="Wrap" /></StackPanel></Border>
                                </Grid>
                            </Grid>
                        </ui:GlassPanel>

                        <StackPanel x:Name="AnalyticsArea" Spacing="15" Visibility="{x:Bind ViewModel.AreChartsVisible, Mode=OneWay}">
                            <Grid Margin="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ui:LiquidSelector Background="#4AFFFFFF" Padding="3" BorderBrush="#70FFFFFF" BorderThickness="1" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}"><StackPanel Orientation="Horizontal">
                                    <RadioButton Content="日" Tag="Day" GroupName="Period" Style="{StaticResource GlassRadio}" Checked="Period_Click" Click="Period_Click" AutomationProperties.Name="今天" AutomationProperties.AutomationId="PeriodDay" />
                                    <RadioButton Content="周" Tag="Week" GroupName="Period" IsChecked="True" Style="{StaticResource GlassRadio}" Checked="Period_Click" Click="Period_Click" AutomationProperties.Name="本周" AutomationProperties.AutomationId="PeriodWeek" />
                                    <RadioButton Content="月" Tag="Month" GroupName="Period" Style="{StaticResource GlassRadio}" Checked="Period_Click" Click="Period_Click" AutomationProperties.Name="本月" AutomationProperties.AutomationId="PeriodMonth" />
                                    <RadioButton Content="年" Tag="Year" GroupName="Period" Style="{StaticResource GlassRadio}" Checked="Period_Click" Click="Period_Click" AutomationProperties.Name="今年" AutomationProperties.AutomationId="PeriodYear" />
                                    <RadioButton Content="全部" Tag="All" GroupName="Period" Style="{StaticResource GlassRadio}" Checked="Period_Click" Click="Period_Click" AutomationProperties.AutomationId="PeriodAll" />
                                </StackPanel></ui:LiquidSelector>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PeriodRange, Mode=OneWay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid x:Name="ChartGrid" ColumnSpacing="18" RowSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ui:GlassPanel x:Name="TrendCard" Padding="22,20,22,15" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}">
                                    <StackPanel Spacing="12">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="专注趋势" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                            <ui:LiquidSelector Grid.Column="1" Background="#38FFFFFF" BorderBrush="#507B9FBD" BorderThickness=".5" Padding="2" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}"><StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="TrendLine" GroupName="TrendKind" Content="折线图" Style="{StaticResource GlassRadio}" Padding="12,7" Tag="Line" Click="Trend_Click" AutomationProperties.AutomationId="TrendLine" />
                                                <RadioButton x:Name="TrendBar" GroupName="TrendKind" Content="柱状图" Style="{StaticResource GlassRadio}" Padding="12,7" Tag="Bar" Click="Trend_Click" AutomationProperties.AutomationId="TrendBar" />
                                            </StackPanel></ui:LiquidSelector>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{x:Bind ViewModel.SelectedTotalDisplay, Mode=OneWay}" Foreground="#3A7EBC" FontSize="13" /><TextBlock Text="{x:Bind ViewModel.SelectedRecordCountDisplay, Mode=OneWay}" Style="{StaticResource MutedText}" /></StackPanel>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ui:StudyChart x:Name="TrendChart" Points="{x:Bind ViewModel.TrendPoints, Mode=OneWay}" Kind="{x:Bind ViewModel.TrendKind, Mode=OneWay}" AutomationProperties.Name="专注趋势图表" /></ScrollViewer>
                                    </StackPanel>
                                </ui:GlassPanel>
                                <ui:GlassPanel x:Name="TopicCard" Grid.Column="1" Padding="22,20,22,15" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}">
                                    <StackPanel Spacing="12">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="主题分布" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                            <ui:LiquidSelector Grid.Column="1" Background="#38FFFFFF" BorderBrush="#507B9FBD" BorderThickness=".5" Padding="2" IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}"><StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="TopicLine" GroupName="TopicKind" Content="折线图" Style="{StaticResource GlassRadio}" Padding="12,7" Tag="Line" Click="Topic_Click" AutomationProperties.AutomationId="TopicLine" />
                                                <RadioButton x:Name="TopicBar" GroupName="TopicKind" Content="柱状图" Style="{StaticResource GlassRadio}" Padding="12,7" Tag="Bar" Click="Topic_Click" AutomationProperties.AutomationId="TopicBar" />
                                            </StackPanel></ui:LiquidSelector>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.TopicHint, Mode=OneWay}" Style="{StaticResource MutedText}" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ui:StudyChart x:Name="TopicChart" Categories="True" Points="{x:Bind ViewModel.TopicPoints, Mode=OneWay}" Kind="{x:Bind ViewModel.TopicKind, Mode=OneWay}" AutomationProperties.Name="主题分布图表" /></ScrollViewer>
                                    </StackPanel>
                                </ui:GlassPanel>
                            </Grid>
                        </StackPanel>

                        <ui:GlassPanel IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}" Padding="24,18" Visibility="{x:Bind ViewModel.IsOverviewVisible, Mode=OneWay}">
                            <StackPanel Spacing="12"><Grid><TextBlock Text="最近记录" Style="{StaticResource SectionTitle}" /><Button Content="查看全部  →" Style="{StaticResource GlassButton}" Background="Transparent" BorderThickness="0" Padding="6,2" HorizontalAlignment="Right" Tag="Records" Click="Navigation_Click" /></Grid>
                                <TextBlock Text="从一次专注开始，写下你的第一条学习记录。" Style="{StaticResource MutedText}" Margin="0,8" Visibility="{x:Bind ViewModel.NoRecords, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentRecords}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="data:StudyRecord"><Grid Padding="0,9" BorderBrush="#246C8FAA" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{x:Bind NoteDisplay}" Foreground="#3B536B" /><TextBlock Text="{x:Bind StartedAtDisplay}" Style="{StaticResource MutedText}" FontSize="11" /></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind DurationDisplay}" Foreground="#526E88" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </ui:GlassPanel>

                        <ui:GlassPanel IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}" Padding="24" Visibility="{x:Bind ViewModel.IsAnalyticsVisible, Mode=OneWay}">
                            <StackPanel Spacing="12"><TextBlock Text="主题明细" Style="{StaticResource SectionTitle}" /><TextBlock Text="点选一个主题，查看本周期内的学习记录。" Style="{StaticResource MutedText}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopicTotals, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="data:TopicTotal"><Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource GlassButton}" Background="Transparent" BorderThickness="0" Padding="2,10" Tag="{x:Bind Label}" Click="TopicDetails_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" /><TextBlock Grid.Column="1" Text="查看记录  →" Style="{StaticResource MutedText}" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </ui:GlassPanel>

                        <ui:GlassPanel IsLiquid="{x:Bind ViewModel.UseLiquidStyle, Mode=OneWay}" Padding="24" Visibility="{x:Bind ViewModel.IsRecordsVisible, Mode=OneWay}">
                            <StackPanel Spacing="18"><Grid><TextBlock Text="{x:Bind ViewModel.RecordsHeading, Mode=OneWay}" Style="{StaticResource SectionTitle}" /><Button Content="全部记录" Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Tag="Records" Click="Navigation_Click" Padding="12,5" /></Grid>
                                <TextBlock Text="这里还没有学习记录。" Style="{StaticResource MutedText}" Visibility="{x:Bind ViewModel.NoFilteredRecords, Mode=OneWay}" />
                                <ListView ItemsSource="{x:Bind ViewModel.FilteredRecords}" SelectionMode="None" ItemContainerStyle="{StaticResource RecordItem}"><ListView.ItemTemplate><DataTemplate x:DataType="data:StudyRecord"><Grid Padding="0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="{x:Bind NoteDisplay}" Foreground="#324B66" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind StartedAtDisplay}" Style="{StaticResource MutedText}" /></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind DurationDisplay}" Margin="20,0" VerticalAlignment="Center" Foreground="#427DAC" /><Button Grid.Column="2" Tag="{x:Bind Id}" Click="DeleteRecord_Click" Style="{StaticResource GlassButton}" Content="删除" Foreground="#98676B" Background="#18FFFFFF" Padding="12,6" VerticalAlignment="Center" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                            </StackPanel>
                        </ui:GlassPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        <Border BorderBrush="#B0FFFFFF" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" />
    </Grid>
</Page>
